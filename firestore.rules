/**
 * This ruleset enforces a "public dropbox" model for newsletter subscriptions,
 * combined with role-based access control for administrative functions.
 *
 * Core Philosophy:
 * The primary goal is to allow any user, including unauthenticated visitors, to
 * submit their information to a newsletter subscription list.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for readable, reusable logic
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user has an admin role.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Newsletter subscriptions rules.
     */
    match /newsletter_subscriptions/{subscriptionId} {
      allow get: if true; // Permitindo leitura para o painel adm protótipo
      allow list: if true; // Permitindo leitura para o painel adm protótipo
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for 'Coming Soon' leads (main contact form).
     */
    match /coming_soon_leads/{leadId} {
      allow get: if true; // Permitindo leitura para o painel adm protótipo
      allow list: if true; // Permitindo leitura para o painel adm protótipo
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures the admin role documents.
     */
    match /roles_admin/{adminId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
